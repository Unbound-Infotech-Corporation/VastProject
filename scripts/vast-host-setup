#!/usr/bin/env bash
# Guided CLI: turn this Ubuntu box into a Vast.ai host.
# This is the primary installer UX (works over SSH / IPMI SOL / desktop terminal).

set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "${HERE}/lib.sh"

ASSUME_YES="${ASSUME_YES:-}"

banner() {
  clear 2>/dev/null || true
  echo -e "${BOLD}${CYAN}"
  cat <<'EOF'
 __     __        _     _   _           _
 \ \   / /_ _ ___| |_  | | | | ___  ___| |_
  \ \ / / _` / __| __| | |_| |/ _ \/ __| __|
   \ V / (_| \__ \ |_  |  _  | (_) \__ \ |_
    \_/ \__,_|___/\__| |_| |_|\___/|___/\__|
          Host Setup  ·  Unbound Infotech
EOF
  echo -e "${NC}"
  print_safety_banner
  echo
}

pause() {
  echo
  read -r -p "Press Enter to return to the menu..." _
}

show_path() {
  cat <<'EOF'

New machine → rent on Vast.ai
-----------------------------
1. Install Ubuntu Server 22.04 or 24.04
     EFI ≥256MB, root ext4 ≥80GB, remaining disk as XFS for Docker
     Official ISO: https://releases.ubuntu.com/
2. On this repo, run this menu or:
     ./scripts/bootstrap-host.sh          # drivers, Docker, nvidia-ctk
     reboot && nvidia-smi -q
3. Create a dedicated HOST account (not your renter account)
     https://cloud.vast.ai/host/setup/    # accept agreement, copy key
     ./scripts/install-vast-daemon.sh --auth-key YOUR_KEY
4. Forward a continuous TCP+UDP port range to this host
     3 ports/GPU minimum, 100/GPU recommended
5. Run optimizer checks / safe fixes
     ./scripts/optimize/collect-status.sh
     ./scripts/optimize/run.sh All --apply
6. Confirm the machine appears on the Vast Machines page
7. Optional dashboard:
     ./scripts/install-dashboard.sh
     open http://<this-host>:5000

Official docs: https://cloud.vast.ai/host/setup/
               https://docs.vast.ai/host/hosting-overview
EOF
}

while true; do
  banner
  echo -e "${BOLD}What do you want to do?${NC}"
  echo "  1) Check host readiness"
  echo "  2) Bootstrap Ubuntu (NVIDIA drivers, Docker, nvidia-ctk)"
  echo "  3) Install Vast.ai host daemon (paste console auth key)"
  echo "  4) Run optimizer — check only"
  echo "  5) Run optimizer — safe one-click fixes (no disk wipe)"
  echo "  6) Install / start the dark-terminal dashboard"
  echo "  7) Show the new-machine → rent path"
  echo "  8) Dry-run bootstrap (print planned steps)"
  echo "  q) Quit"
  echo
  read -r -p "Select: " choice
  case "$choice" in
    1)
      "${HERE}/optimize/collect-status.sh" | python3 -m json.tool || "${HERE}/optimize/collect-status.sh"
      pause
      ;;
    2)
      "${HERE}/bootstrap-host.sh"
      pause
      ;;
    3)
      "${HERE}/install-vast-daemon.sh"
      pause
      ;;
    4)
      "${HERE}/optimize/run.sh" All
      pause
      ;;
    5)
      warn "Safe fixes only: persistence mode, nvidia-ctk/Docker merge, sysctl."
      warn "Storage format is NOT run from this option."
      if confirm "Apply safe optimizer fixes now?"; then
        "${HERE}/optimize/run.sh" All --apply
      fi
      pause
      ;;
    6)
      "${HERE}/install-dashboard.sh"
      pause
      ;;
    7)
      show_path
      pause
      ;;
    8)
      "${HERE}/bootstrap-host.sh" --dry-run
      pause
      ;;
    q|Q)
      echo "Bye."
      exit 0
      ;;
    *)
      warn "Unknown selection."
      sleep 1
      ;;
  esac
done
