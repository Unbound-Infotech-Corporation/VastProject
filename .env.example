# Copy to .env. DATABASE_URL is optional — without it, logs stay in memory.

# DATABASE_URL=postgresql://vastai_user:change-me@127.0.0.1:5432/vastai_optimizer
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Required for dashboard "Optimize" buttons (safe fixes only — no disk wipe).
ALLOW_OPTIMIZE=true

# Optional: allow optimize from non-localhost (or set a shared token).
# ALLOW_REMOTE_OPTIMIZE=true
# OPTIMIZE_TOKEN=

# Only enable if you intentionally want SO_REUSEPORT.
# REUSE_PORT=false
